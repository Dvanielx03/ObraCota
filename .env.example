# Copia este archivo como .env y ajusta los valores. El archivo .env no se sube al repositorio.

# Puerto de tu máquina donde queda la landing.
LANDING_PORT=3200
APP_PORT=3201
# Dirección pública de la landing (se fija al construir la imagen).
SITE_URL=http://localhost:3200
PANEL_URL=http://localhost:3201

# Backend y base de datos. Genera dos secretos independientes.
BACKEND_PORT=8080
# Clave aleatoria de al menos 32 bytes codificada en Base64.
JWT_SECRET=
# HTTP local. En HTTPS usa true.
COOKIE_SECURE=false
POSTGRES_DB=obracota
POSTGRES_USER=obracota
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Solo backend. Cada terna reserva 100 centavos del límite mensual UTC.
GEMINI_API_KEY=
AI_MONTHLY_LIMIT_CENTS=800
