APP_PORT=3201
# Dirección pública de la landing (se fija al construir la imagen).
SITE_URL=http://localhost:3200
PANEL_URL=http://localhost:3201

# Solo con el perfil "datos".
POSTGRES_DB=obracota
POSTGRES_USER=obracota
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
